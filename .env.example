# Configuração do Servidor de E-mail (SMTP) para envio de orçamentos com anexo
# Suporta Gmail (com Senha de Aplicativo), Hostinger, Outlook, Titan ou cPanel

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@rotaacademica.com.br
# Insira aqui a sua Senha de Aplicativo gerada (ex: no Gmail -> Segurança -> Senhas de App)
SMTP_PASS=sua_senha_de_aplicativo_aqui

# E-mail de destino que receberá os orçamentos com anexo
CONTACT_EMAIL=contato@rotaacademica.com.br

# String de Conexão com o Banco de Dados PostgreSQL (Supabase, Neon, Vercel Postgres, Railway ou Local)
# Exemplo: postgresql://usuario:senha@localhost:5432/rota_academica
DATABASE_URL="postgresql://neondb_owner:npg_vLK3kVt7Fcnh@ep-mute-bird-aci9gsv3-pooler.sa-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=verify-full"